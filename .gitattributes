# Enforce LF line endings for all source files
* text=auto eol=lf

# Explicitly mark source files as text
*.c text eol=lf
*.h text eol=lf
*.asm text eol=lf
*.s text eol=lf
*.ld text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files - don't touch
*.o binary
*.elf binary
*.iso binary
*.img binary

# ── Language statistics ───────────────────────────────────────────
# CharisOS is a standalone operating system: it boots on bare metal and in a
# virtual machine, and it is written in C and NASM. Nothing in this repository
# runs on, links against, or depends on Windows, Linux or macOS.
#
# The .bat/.ps1/.sh files here are optional convenience wrappers that drive the
# SAME host toolchain (gcc, nasm, grub-mkrescue) on whatever machine a
# developer happens to use. They are not part of the OS and are not part of
# what it executes. Marking them generated keeps them out of GitHub's language
# bars, which otherwise report Batchfile and PowerShell as part of the project
# and imply exactly the dependency that does not exist.
*.bat linguist-generated=true
*.ps1 linguist-generated=true
*.sh  linguist-generated=true
Makefile linguist-generated=true
link.ld linguist-generated=true
