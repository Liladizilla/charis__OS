# Enforce LF line endings for all source files
* text=auto eol=lf

# Explicitly mark source files as text
*.c text eol=lf
*.h text eol=lf
*.asm text eol=lf
*.s text eol=lf
*.ld text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files - don't touch
*.o binary
*.elf binary
*.iso binary
*.img binary